<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#66FFFFFF" /></shape></item>
            <item android:inset="9dp"><shape android:shape="oval"><solid android:color="#66FFFFFF" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFFFF" /></shape></item>
            <item android:inset="12dp"><shape android:shape="oval"><solid android:color="#FFB4E43A" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="#FFFFFFFF" /></shape></item>
            <item android:inset="9dp"><shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape></item>
        </layer-list>
    </item>
</selector>
